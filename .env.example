# PostgreSQL connection. Supabase's direct or pooler URL is compatible.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public read-only BSC RPCs are safe defaults; set dedicated endpoints for reliability.
BSC_MAINNET_RPC_URL=https://bsc.publicnode.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Optional credentialed archive endpoint; Relic does not depend on NodeReal.
NODEREAL_BSC_RPC_URL=

# ERC-8004 deployment selected by the indexer. Keep explicit because deployments evolve.
ERC8004_CHAIN_ID=56
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Earliest BSC registration currently indexed by 8004scan; re-verify when backfilling.
ERC8004_START_BLOCK=79094807
ERC8004_CONFIRMATION_DEPTH=15
ERC8004_BLOCK_RANGE=2000
ERC8004_MIN_BLOCK_RANGE=25
ERC8004_RPC_RETRIES=3
# Optional safety cap per invocation. Omit for continuous catch-up.
INDEXER_MAX_BLOCKS=10000

# Optional. Sent only as the documented X-API-Key header. Without it, Relic
# runs in anonymous smoke-test mode (10 requests/minute, 100/day). Full-corpus
# mode requires this key and verifies an observed Pro limit before checkpointing.
8004SCAN_API_KEY=

API_PORT=8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public Privy application identifiers. Configure the app for wallet login and
# add localhost plus deployed Relic origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server-only Privy verification key. Copy the complete public-key PEM from
# the Privy dashboard. Keep it on one line using literal \n characters; do
# not expose it with a NEXT_PUBLIC_ prefix.
# PRIVY_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PRIVY_JWT_VERIFICATION_KEY=
LOG_LEVEL=info

# Server-to-server authorization for mandate mutations. Required in production.
# Never prefix this secret with NEXT_PUBLIC_.
MANDATE_API_SECRET=
# Explicit local-only Development principal. Production commerce requires the
# wallet-authenticated boundary and will not accept this as buyer authority.
RELIC_DEVELOPMENT_PRINCIPAL_ID=01945b1e-7e80-7000-8000-000000000900

# Production wallet authentication and EIP-712 commerce configuration.
# Use the public web origin for both domain and URI. Addresses are chain-specific.
RELIC_WALLET_AUTH_DOMAIN=localhost
RELIC_WALLET_AUTH_URI=http://localhost:3000
RELIC_PUBLIC_ORIGIN=http://localhost:3000
# Stable EIP-712 verifying-contract address for Relic buyer approvals. Use the
# deployed ERC-8183 policy address for the selected network.
RELIC_COMMERCE_EIP712_DOMAIN_ADDRESS=
RELIC_ERC8183_COMMERCE_ADDRESS=
RELIC_ERC8183_EVALUATOR_ADDRESS=
