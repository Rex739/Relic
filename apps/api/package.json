{
  "name": "@relic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env.local --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.7.1",
    "@bnbagent/sdk": "0.5.0",
    "@hono/node-server": "2.1.0",
    "@hono/zod-openapi": "1.5.2",
    "@privy-io/node": "^0.34.0",
    "@relic/config": "workspace:*",
    "@relic/database": "workspace:*",
    "@relic/domain": "workspace:*",
    "@relic/validation": "workspace:*",
    "hono": "4.13.1",
    "viem": "2.55.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12"
  }
}
