# Private Layer A runtime for the Relic LP Range Rebalancer.
# Build context: agents/RelicLpRangeRebalancer. The Altana session enters only
# as a Northflank runtime secret; `.studio` is excluded by `.dockerignore`.
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/agent/package.json ./app/agent/package.json
RUN pnpm install --frozen-lockfile

COPY app/agent ./app/agent
RUN pnpm --filter RelicLpRangeRebalancer-agent build

FROM node:22-alpine

WORKDIR /workspace/app/agent
ENV NODE_ENV=production
ENV PORT=9000

COPY --from=build /workspace /workspace

RUN mkdir -p /workspace/.studio/wallets \
  && chown -R node:node /workspace/.studio

USER node
EXPOSE 9000
CMD ["node", "dist/unifiedMain.js"]
