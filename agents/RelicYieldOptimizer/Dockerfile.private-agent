FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/agent/package.json ./app/agent/package.json
RUN pnpm install --frozen-lockfile
COPY app/agent ./app/agent
RUN pnpm --filter relic-yield-optimizer-agent build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /workspace/app/agent/dist ./dist
RUN mkdir -p /app/.studio/wallets && chown -R node:node /app
USER node
EXPOSE 9000
CMD ["node", "dist/server.js"]
