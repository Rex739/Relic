FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/agent/package.json ./app/agent/package.json
RUN pnpm install --frozen-lockfile
COPY app/agent ./app/agent
RUN pnpm --filter relic-yield-optimizer-agent build
# The runtime image must contain production dependencies as well as compiled
# output. `deploy` produces a standalone package with pnpm's symlinks resolved.
RUN pnpm --filter relic-yield-optimizer-agent --prod --legacy deploy /runtime

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /runtime ./
RUN mkdir -p /app/.studio/wallets && chown -R node:node /app
USER node
EXPOSE 9000
CMD ["node", "dist/server.js"]
