# Private Layer A Health Guard executor. Build context: repository root.
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY agents/RelicHealthGuard/package.json ./agents/RelicHealthGuard/package.json
RUN pnpm install --frozen-lockfile --filter relic-health-guard...
COPY agents/RelicHealthGuard ./agents/RelicHealthGuard
RUN pnpm --filter relic-health-guard build
RUN pnpm --filter relic-health-guard --prod deploy /runtime

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /runtime ./
USER node
EXPOSE 9000
CMD ["node", "dist/private-server.js"]
