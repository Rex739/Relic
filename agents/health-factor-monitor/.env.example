NETWORK=bsc-testnet
WALLET_PASSWORD=enter-interactively-or-set-locally
# First encrypted-keystore import only; remove immediately after import.
# PRIVATE_KEY=0x...
# WALLET_ADDRESS=0x...
WALLET_KEYSTORE_DIR=.wallets

ERC8183_SERVICE_PRICE=0
ERC8183_AGENT_URL=http://localhost:8003/erc8183
ERC8183_FUNDED_POLL_INTERVAL=15
STORAGE_LOCAL_PATH=.agent-data
PORT=8003

BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Pin this to the current official Venus Core Comptroller deployment before live use.
VENUS_BSC_TESTNET_COMPTROLLER=0x...
