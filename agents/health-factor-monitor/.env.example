NETWORK=bsc-testnet
WALLET_PASSWORD=
# First encrypted-keystore import only; remove immediately after import.
# PRIVATE_KEY=0x...
# WALLET_ADDRESS=0x...
WALLET_KEYSTORE_DIR=.studio/wallets

# Required by the production runtime for durable ERC-8183 deliverable manifests.
DATABASE_URL=postgresql://...

ERC8183_SERVICE_PRICE=0
ERC8183_AGENT_URL=http://localhost:8003/erc8183
# Official bnb-chain/apex-contracts source: scripts/addresses.ts >
# ADDRESSES.bscTestnet.policy. SDK 0.5.0 may lag a testnet policy rotation.
ERC8183_POLICY_ADDRESS=0xd6a4217588f6b1f5657a92a3e94e6422ad771cea
ERC8183_FUNDED_POLL_INTERVAL=15
ERC8183_SIGNED_QUOTE_TTL_SECONDS=900
PORT=8003

BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# @bnbagent/sdk reads this name for commerce/event verification. Keep it on an
# endpoint that supports bounded multi-block eth_getLogs queries.
RPC_URL_BSC_TESTNET=https://bsc-testnet-rpc.publicnode.com
# Official VenusProtocol/venus-protocol-documentation source:
# deployed-contracts/markets.md > BNB Chain Testnet > Core Pool > Comptroller.
VENUS_BSC_TESTNET_COMPTROLLER=0x94d1820b2D1c7c7452A163983Dc888CEC546b77D
